# AegisAI Environment Configuration
# Copy this file to .env and customize values

# ===========================================
# Database Persistence
# ===========================================
# SQLite (default - zero config, good for development)
DATABASE_URL=sqlite:///data/aegis.db
DATABASE_RETENTION_DAYS=30
DATABASE_SNAPSHOT_RETENTION_DAYS=7
DATABASE_AUTO_CLEANUP=true

# PostgreSQL (production - uncomment to use)
# DATABASE_URL=postgresql://aegis:aegis_secret@localhost:5432/aegisai
# POSTGRES_USER=aegis
# POSTGRES_PASSWORD=aegis_secret
# POSTGRES_DB=aegisai

# ===========================================
# Redis (Caching & Sessions)
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# API Security
# ===========================================
AEGIS_API_KEY=your-secret-api-key-here
# Required only for /api/admin/system-knowledge writes. Keep this distinct from
# AEGIS_API_KEY and server-side only. Never expose either key through NEXT_PUBLIC_*.
AEGIS_ADMIN_API_KEY=your-separate-admin-secret-here
AEGIS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Rate Limiting
AEGIS_RATE_LIMIT=60
AEGIS_RATE_LIMIT_WINDOW=60

# ===========================================
# Debug Mode
# Keep this false for normal development too: true enables Uvicorn reload and
# per-frame diagnostics, which can compete with real-time voice responses.
# ===========================================
AEGIS_DEBUG=false
AEGIS_LOG_LEVEL=INFO

# ===========================================
# Local real-time performance
# ===========================================
# Keep video inference bounded so the API and Gemini Live gateway remain
# responsive. Raise this only after profiling on a dedicated GPU host.
AEGIS_CAMERA_INFERENCE_WORKERS=1
# Preview frame delivery only; it never changes detection, tracking, or risk.
AEGIS_CAMERA_STREAM_FPS=5
# The small model is a practical CPU default. Use yolo11s.pt when accuracy is
# more important than the extra local inference cost.
AEGIS_DETECTION_MODEL_PATH=yolo11n.pt


# Local weapon detection. yolo11n already supplies real knife, baseball-bat,
# and scissors classes. Guns and other custom labels require compatible local
# weights at this path; absence is reported as a capability limitation. The
# JSON maps must match the class IDs/names embedded in those local weights.
AEGIS_WEAPON_MODEL_PATH=models/weapon_detector.pt
AEGIS_WEAPON_CONFIDENCE_THRESHOLD=0.35
AEGIS_WEAPON_CLASS_NAMES_JSON={"0":"knife","1":"pistol"}
AEGIS_WEAPON_INTERNAL_CLASS_IDS_JSON={"0":1000,"1":1001}

# ===========================================
# API Server
# ===========================================
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8080

# ===========================================
# Dashboard server proxy
# ===========================================
# Configure these server-only values in frontend/.env.local when the Next.js
# dashboard runs separately. Never expose AEGIS_API_KEY through NEXT_PUBLIC_*.

# ===========================================
# Google Gemini AI (LLM for NLQ)
# ===========================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# ===========================================
# Gemini Live Voice Intelligence Copilot (server-only)
# ===========================================
# Keep GEMINI_API_KEY on the FastAPI server. Never place it in a
# NEXT_PUBLIC_* frontend variable or a WebSocket URL.
GEMINI_LIVE_ENABLED=false
# Verify model and voice availability for your Gemini account before enabling.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Kore is the default Aegis Live voice. Confirm availability in Gemini AI
# Studio before changing this value for a production deployment.
GEMINI_LIVE_VOICE=Kore
# PCM input is signed 16-bit mono; output is native signed 16-bit mono PCM.
# These values are backend-only and are negotiated to the browser without
# exposing the provider model, voice, credentials, or upstream connection.
GEMINI_LIVE_INPUT_SAMPLE_RATE=16000
GEMINI_LIVE_OUTPUT_SAMPLE_RATE=24000
# Short-lived browser connection token and maximum Live audio-session duration.
GEMINI_LIVE_SESSION_TTL_SECONDS=120
GEMINI_LIVE_MAX_SESSION_SECONDS=900
# 0 disables retaining completed transcripts in the gateway process.
GEMINI_LIVE_TRANSCRIPT_RETENTION_SECONDS=0
GEMINI_LIVE_TOOL_AUDIT_RETENTION_SECONDS=3600

# ===========================================
# Semantic Layer (Grounding DINO)
# ===========================================
SEMANTIC_ENABLED=false
SEMANTIC_BOX_THRESHOLD=0.35
SEMANTIC_TEXT_THRESHOLD=0.25
SEMANTIC_RISK_TRIGGER_THRESHOLD=0.6
SEMANTIC_CACHE_TTL=60
SEMANTIC_MAX_CONCURRENT=2
# Leave empty for auto (GPU-first, CPU fallback)
SEMANTIC_DEVICE=

# ===========================================
# Vehicle Intelligence (all optional; disabled by default)
# ===========================================
# Vehicle enrichment is tracker-aware and never changes normal detection/risk
# behaviour. Plate values remain restricted backend evidence and are not part
# of the standard operator track payload.
VEHICLE_ENRICHMENT_ENABLED=false
PLATE_OCR_ENABLED=false
PLATE_OCR_DEVICE=auto
# Local paths only. No OCR, plate-detector, or make/model weights are fetched
# automatically. PaddleOCR must be installed in a compatible isolated runtime.
PLATE_OCR_MODEL_DIR=
PLATE_DETECTOR_MODEL_PATH=
VEHICLE_COLOR_ENABLED=false
VEHICLE_MAKE_MODEL_ENABLED=false
VEHICLE_MAKE_MODEL_MODEL_PATH=
VEHICLE_MAKE_MODEL_LABELS_PATH=
VEHICLE_MAKE_MODEL_ARCHITECTURE=
VEHICLE_ENRICHMENT_INTERVAL_SECONDS=1.5
VEHICLE_ENRICHMENT_MAX_ENRICHMENTS_PER_FRAME=1
VEHICLE_ENRICHMENT_TRACKER_STATE_TTL_SECONDS=120
VEHICLE_ENRICHMENT_TRACKER_CACHE_LIMIT=500
VEHICLE_MIN_CROP_WIDTH=160
VEHICLE_MIN_CROP_HEIGHT=80
VEHICLE_MIN_SHARPNESS=80
VEHICLE_MIN_BRIGHTNESS=35
EVIDENCE_DEDUPLICATION_ENABLED=true
EVIDENCE_PHASH_MAX_DISTANCE=8
EVIDENCE_CACHE_LIMIT=500
EVIDENCE_RETENTION_SECONDS=180
INFERENCE_BACKEND=torch
