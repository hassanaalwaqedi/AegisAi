# AegisAI Frontend Environment
# These variables are read only by the Next.js server route at /api/backend/*.
# Never use NEXT_PUBLIC_* for AEGIS_API_KEY or another privileged credential.
AEGIS_API_URL=http://127.0.0.1:8080
AEGIS_API_KEY=replace-with-a-server-side-development-key

# This is a public endpoint, not a credential. It is required for a deployed
# Gemini Live browser gateway when it is not served from the dashboard origin.
NEXT_PUBLIC_AEGIS_LIVE_WS_URL=ws://127.0.0.1:8080
